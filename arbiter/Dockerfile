# syntax=docker/dockerfile:1.7
#
# ARBITER API image.
#
# Supply-chain properties this build has that the previous single-stage
# image did not:
#
#   - **Hash-pinned dependencies.** `requirements.lock` is generated by
#     `pip-compile --generate-hashes` and installed with `--require-hashes`,
#     so a compromised or re-uploaded package on the index cannot substitute
#     itself into the image. The previous build installed from `>=` floors,
#     which meant two builds a week apart could ship different code.
#   - **No dev dependencies at runtime.** The old image ran
#     `pip install -e ".[dev]"`, shipping pytest, hypothesis, and
#     import-linter into production -- more code to audit, for no benefit.
#   - **Non-root**, with no write access to its own source. Rulepacks are
#     content-addressed data that decisions pin by hash; a process able to
#     rewrite them is a process able to rewrite history.
#   - **No build toolchain in the runtime layer.** Wheels are built in a
#     separate stage; the final image has no compiler.
#
# Two targets:
#
#   --target runtime       (default) includes torch + a vendored DeBERTa-NLI
#                          checkpoint, so the MANDATORY semantic
#                          contradiction layer actually runs. ~2.5 GB.
#   --target runtime-slim  omits them. The layer reports UNAVAILABLE and
#                          every case with comparable claim pairs escalates
#                          -- correct fail-closed behaviour, but a
#                          permanently degraded mode. Use only where a
#                          separate NLI service serves that layer.
#
# Model weights are baked in rather than fetched at boot: a dispute service
# that downloads model weights from the public internet at startup has a
# supply-chain dependency it cannot audit and an outage mode it does not
# control.

ARG PYTHON_VERSION=3.12

# ---------------------------------------------------------------- builder
FROM python:${PYTHON_VERSION}-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Dependencies first, from the lockfile only, so a source-only change does
# not re-resolve or re-download anything.
COPY requirements.lock ./
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --require-hashes --no-deps -r requirements.lock

# Then the application, without touching its dependencies again.
COPY pyproject.toml README.md ./
COPY src ./src
RUN /opt/venv/bin/pip install --no-deps .

# ------------------------------------------------------------ nli-builder
# Separate stage so the multi-hundred-megabyte download is cached
# independently of both the dependency layer and the source layer.
FROM builder AS nli-builder
ARG NLI_VARIANT=base
RUN /opt/venv/bin/pip install --no-cache-dir \
      --extra-index-url https://download.pytorch.org/whl/cpu \
      "transformers>=4.44" "torch>=2.4" "sentencepiece>=0.2" "protobuf>=4.25"
COPY scripts/fetch_nli_model.py ./scripts/
RUN if [ "$NLI_VARIANT" = "large" ]; then \
      /opt/venv/bin/python scripts/fetch_nli_model.py --dest /opt/models/nli ; \
    else \
      /opt/venv/bin/python scripts/fetch_nli_model.py --dest /opt/models/nli --base ; \
    fi

# ------------------------------------------------------------- base-image
# Everything common to both targets. Split out so `runtime-slim` never
# causes BuildKit to schedule the nli-builder stage at all -- a target that
# merely *mentions* a heavy stage still builds it.
FROM python:${PYTHON_VERSION}-slim AS base-runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=0 \
    PATH="/opt/venv/bin:$PATH"

# libmagic is a genuine runtime dependency of the ingest scanner; curl is
# for the healthcheck. No compiler, no package-manager state.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libmagic1 curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --shell /usr/sbin/nologin --uid 10001 arbiter

WORKDIR /app
# Root-owned and not writable by the runtime user.
COPY --chown=root:root alembic.ini ./
COPY --chown=root:root alembic ./alembic
COPY --chown=root:root rulepacks ./rulepacks
COPY --chown=root:root scripts ./scripts
COPY --chown=root:root sdk ./sdk

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:8000/health || exit 1

# Migrations are deliberately NOT run here: `alembic upgrade head` in the
# container command means every replica races to migrate on rollout. It
# belongs in a pre-deploy job. docker-compose runs it explicitly for local
# use, where there is exactly one replica.
CMD ["uvicorn", "arbiter.main:app", "--host", "0.0.0.0", "--port", "8000"]

# --------------------------------------------------------- runtime (full)
FROM base-runtime AS runtime
COPY --from=nli-builder /opt/venv /opt/venv
COPY --from=nli-builder /opt/models /opt/models
ENV ARBITER_NLI_MODEL_PATH=/opt/models/nli
USER arbiter

# ---------------------------------------------------------- runtime-slim
FROM base-runtime AS runtime-slim
COPY --from=builder /opt/venv /opt/venv
USER arbiter
