# ARBITER — local development environment.
#
#     cp .env.example .env
#
# `arbiter.config.Settings` reads `.env` automatically (env_file=".env"), so
# this is what makes a HOST-RUN stack -- `uvicorn arbiter.main:app` plus
# `scripts/run_adjudication_worker.py` in separate terminals -- behave like
# the compose stack. docker-compose.yml already sets all of these on the
# api, worker, and clock services; running outside compose is the case that
# previously had nothing supplying them.
#
# Why that mattered, concretely: adjudication runs in the WORKER process and
# the audit trail is read back through the API process. With no seed set,
# each process generates its OWN ephemeral Ed25519 key at import, so the
# worker signed events the API could not verify -- `GET /v1/audit/{case_id}`
# returned `signatures_valid: false` on every case, and the console rendered
# a permanently unverified audit chain. Nothing was wrong with the signing
# or verification logic; the two processes simply never shared a key.
#
# The values below are deliberately obvious, low-entropy, and identical to
# docker-compose.yml's, so they cannot be mistaken for production secrets.
# `ARBITER_ENV=dev` keeps `validate_for_environment()` permissive; setting
# it to anything else makes the process REFUSE TO BOOT until real secrets
# from a real secret store replace every line here.

ARBITER_ENV=dev

# Infrastructure (host-run defaults: services published on localhost by
# `docker compose up -d db redis minio`).
ARBITER_DATABASE_URL=postgresql+psycopg://arbiter:arbiter@localhost:5432/arbiter
ARBITER_REDIS_URL=redis://localhost:6379/0
ARBITER_OLLAMA_BASE_URL=http://localhost:11434

# POST /v1/auth/dev-token mints a bearer token for ANY role, including
# ADMIN, with no identity check. It exists so the console and demo scripts
# have something to call without a real IdP. Development only.
ARBITER_ENABLE_DEV_AUTH=true

# Bearer-token HMAC secret.
ARBITER_AUTH_SECRET=dev-only-compose-secret-not-for-any-real-deployment

# Audit-chain and transparency-log signing keys. Every process that writes
# or verifies audit events MUST share these -- see the note above.
ARBITER_SIGNING_KEY_SEED=1111111111111111111111111111111111111111111111111111111111111111
ARBITER_LOG_OPERATOR_KEY_SEED=2222222222222222222222222222222222222222222222222222222222222222
ARBITER_TSA_KEY_SEED=3333333333333333333333333333333333333333333333333333333333333333

# Fernet KEK wrapping the per-subject crypto-shredding keys. Without it
# subject keys are never persisted and every encrypted PII field becomes
# permanently unrecoverable when the process exits.
ARBITER_KEY_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWVuY3J5cHRpb24ta2V5LTMyYnk=

ARBITER_PAN_TOKENIZATION_KEY=dev-only-pan-tokenization-key-not-for-production
