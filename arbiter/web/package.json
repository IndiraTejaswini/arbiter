{
  "name": "arbiter-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ARBITER console — card member portal, merchant console, analyst workbench, compliance surfaces. Pure React + Tailwind on Vite; no Next.js, no SSR, no server runtime.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.3",
    "vite": "5.4.2"
  }
}
